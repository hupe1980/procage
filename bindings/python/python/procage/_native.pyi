import os
from typing import Any

class Error(Exception): ...
class PolicyError(Error): ...

class CapabilityGapError(Error):
    gaps: list[dict[str, Any]]

class UnsupportedError(Error): ...
class AlreadySandboxedError(Error): ...
class GrantError(Error): ...
class SpawnError(Error): ...

class Policy:
    @staticmethod
    def preset(
        name: str, version: int, workspace: str | os.PathLike[str] | None = None
    ) -> Policy: ...
    @staticmethod
    def from_json(text: str) -> Policy: ...
    def to_json(self) -> str: ...
    @property
    def workspace(self) -> str | None: ...

class Cage:
    def __init__(
        self,
        policy: Policy,
        *,
        violations: bool = False,
        relax: list[str] = ...,
        accept_spawn_snapshot: bool = False,
        allow: list[str] = ...,
    ) -> None: ...
    @property
    def relaxed(self) -> list[str]: ...
    def spawn(
        self,
        args: list[str],
        *,
        cwd: str | None = None,
        env: dict[str, str] | None = None,
        grants: dict[str, str] | None = None,
        stdin: str = "null",
        stdout: str = "pipe",
        stderr: str = "pipe",
    ) -> Run: ...

class Run:
    @property
    def pid(self) -> int: ...
    def poll(self) -> int | None: ...
    def wait(self, timeout: float | None = None) -> int: ...
    def kill(self) -> None: ...
    def communicate(
        self, input: bytes | None = None, timeout: float | None = None
    ) -> tuple[bytes | None, bytes | None]: ...
    def violations(self) -> list[dict[str, Any]]: ...
    def receipt_json(self) -> str | None: ...
    def close(self) -> None: ...
