(version 1)
(deny default)
(allow file-read* (literal "/"))
(allow file-read* (require-any (literal "/dev/random") (literal "/dev/urandom")))
(allow file-read* (require-any (subpath "/Library/Preferences/Logging") (subpath "/private/etc") (subpath "/private/var/db/timezone") (subpath "/private/var/select") (subpath "/usr/share")))
(allow file-read* (subpath "/work"))
(allow file-read* file-write* (extension "procage.tmpdir"))
(allow file-read* file-write-data (require-any (literal "/dev/dtracehelper") (literal "/dev/null") (literal "/dev/zero")))
(allow file-read* file-write-data (subpath "/dev/fd"))
(allow file-read* process-exec* file-map-executable (require-any (subpath "/System") (subpath "/bin") (subpath "/sbin") (subpath "/usr/bin") (subpath "/usr/lib") (subpath "/usr/libexec") (subpath "/usr/sbin")))
(allow file-read-metadata (require-any (literal "/Library") (literal "/etc") (literal "/private") (literal "/private/var") (literal "/tmp") (literal "/usr") (literal "/var")))
(allow ipc-posix-shm-read* (ipc-posix-name "apple.shm.notification_center"))
(allow mach-lookup (require-any (global-name "com.apple.SystemConfiguration.configd") (global-name "com.apple.oahd") (global-name "com.apple.system.notification_center") (global-name "com.apple.system.opendirectoryd.libinfo") (global-name "com.apple.trustd") (global-name "com.apple.trustd.agent")))
(allow process-fork)
(allow signal (require-any (target self) (target children)))
(allow sysctl-read)
(deny appleevent-send)
(deny file-ioctl (ioctl-command #x80017472))
(deny file-read* file-write* (require-any (regex "^/[uU][sS][eE][rR][sS]/[^/]*/\\.[aA][wW][sS](/.*)?$") (regex "^/[uU][sS][eE][rR][sS]/[^/]*/\\.[cC][aA][rR][gG][oO]/[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL][sS]\\.[tT][oO][mM][lL](/.*)?$") (regex "^/[uU][sS][eE][rR][sS]/[^/]*/\\.[cC][oO][nN][fF][iI][gG]/[gG][cC][lL][oO][uU][dD](/.*)?$") (regex "^/[uU][sS][eE][rR][sS]/[^/]*/\\.[cC][oO][nN][fF][iI][gG]/[gG][hH](/.*)?$") (regex "^/[uU][sS][eE][rR][sS]/[^/]*/\\.[dD][oO][cC][kK][eE][rR]/[cC][oO][nN][fF][iI][gG]\\.[jJ][sS][oO][nN](/.*)?$") (regex "^/[uU][sS][eE][rR][sS]/[^/]*/\\.[gG][iI][tT]-[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL][sS](/.*)?$") (regex "^/[uU][sS][eE][rR][sS]/[^/]*/\\.[gG][nN][uU][pP][gG](/.*)?$") (regex "^/[uU][sS][eE][rR][sS]/[^/]*/\\.[kK][uU][bB][eE](/.*)?$") (regex "^/[uU][sS][eE][rR][sS]/[^/]*/\\.[nN][eE][tT][rR][cC](/.*)?$") (regex "^/[uU][sS][eE][rR][sS]/[^/]*/\\.[pP][yY][pP][iI][rR][cC](/.*)?$") (regex "^/[uU][sS][eE][rR][sS]/[^/]*/\\.[sS][sS][hH](/.*)?$") (regex "^/[uU][sS][eE][rR][sS]/[^/]*/[lL][iI][bB][rR][aA][rR][yY]/[aA][pP][pP][lL][iI][cC][aA][tT][iI][oO][nN] [sS][uU][pP][pP][oO][rR][tT]/[bB][rR][aA][vV][eE][sS][oO][fF][tT][wW][aA][rR][eE](/.*)?$") (regex "^/[uU][sS][eE][rR][sS]/[^/]*/[lL][iI][bB][rR][aA][rR][yY]/[aA][pP][pP][lL][iI][cC][aA][tT][iI][oO][nN] [sS][uU][pP][pP][oO][rR][tT]/[fF][iI][rR][eE][fF][oO][xX](/.*)?$") (regex "^/[uU][sS][eE][rR][sS]/[^/]*/[lL][iI][bB][rR][aA][rR][yY]/[aA][pP][pP][lL][iI][cC][aA][tT][iI][oO][nN] [sS][uU][pP][pP][oO][rR][tT]/[gG][oO][oO][gG][lL][eE]/[cC][hH][rR][oO][mM][eE](/.*)?$") (regex "^/[uU][sS][eE][rR][sS]/[^/]*/[lL][iI][bB][rR][aA][rR][yY]/[aA][pP][pP][lL][iI][cC][aA][tT][iI][oO][nN] [sS][uU][pP][pP][oO][rR][tT]/[mM][iI][cC][rR][oO][sS][oO][fF][tT] [eE][dD][gG][eE](/.*)?$") (regex "^/[uU][sS][eE][rR][sS]/[^/]*/[lL][iI][bB][rR][aA][rR][yY]/[cC][oO][oO][kK][iI][eE][sS](/.*)?$") (regex "^/[uU][sS][eE][rR][sS]/[^/]*/[lL][iI][bB][rR][aA][rR][yY]/[kK][eE][yY][cC][hH][aA][iI][nN][sS](/.*)?$") (regex "^/[uU][sS][eE][rR][sS]/[^/]*/[lL][iI][bB][rR][aA][rR][yY]/[mM][aA][iI][lL](/.*)?$") (regex "^/[uU][sS][eE][rR][sS]/[^/]*/[lL][iI][bB][rR][aA][rR][yY]/[mM][eE][sS][sS][aA][gG][eE][sS](/.*)?$") (regex "^/[uU][sS][eE][rR][sS]/[^/]*/[lL][iI][bB][rR][aA][rR][yY]/[sS][aA][fF][aA][rR][iI](/.*)?$")))
(deny file-write* (require-any (regex "^/(.*/)?\\.[bB][aA][sS][hH]_[pP][rR][oO][fF][iI][lL][eE](/.*)?$") (regex "^/(.*/)?\\.[bB][aA][sS][hH][rR][cC](/.*)?$") (regex "^/(.*/)?\\.[cC][aA][rR][gG][oO]/[cC][oO][nN][fF][iI][gG](/.*)?$") (regex "^/(.*/)?\\.[cC][aA][rR][gG][oO]/[cC][oO][nN][fF][iI][gG]\\.[tT][oO][mM][lL](/.*)?$") (regex "^/(.*/)?\\.[cC][lL][aA][uU][dD][eE](/.*)?$") (regex "^/(.*/)?\\.[cC][oO][dD][eE][xX](/.*)?$") (regex "^/(.*/)?\\.[cC][uU][rR][sS][oO][rR](/.*)?$") (regex "^/(.*/)?\\.[eE][nN][vV][rR][cC](/.*)?$") (regex "^/(.*/)?\\.[gG][iI][tT]/[cC][oO][nN][fF][iI][gG](/.*)?$") (regex "^/(.*/)?\\.[gG][iI][tT]/[hH][oO][oO][kK][sS](/.*)?$") (regex "^/(.*/)?\\.[gG][iI][tT][cC][oO][nN][fF][iI][gG](/.*)?$") (regex "^/(.*/)?\\.[gG][iI][tT][mM][oO][dD][uU][lL][eE][sS](/.*)?$") (regex "^/(.*/)?\\.[iI][dD][eE][aA](/.*)?$") (regex "^/(.*/)?\\.[mM][cC][pP]\\.[jJ][sS][oO][nN](/.*)?$") (regex "^/(.*/)?\\.[nN][pP][mM][rR][cC](/.*)?$") (regex "^/(.*/)?\\.[pP][rR][oO][fF][iI][lL][eE](/.*)?$") (regex "^/(.*/)?\\.[vV][sS][cC][oO][dD][eE](/.*)?$") (regex "^/(.*/)?\\.[zZ][pP][rR][oO][fF][iI][lL][eE](/.*)?$") (regex "^/(.*/)?\\.[zZ][sS][hH][eE][nN][vV](/.*)?$") (regex "^/(.*/)?\\.[zZ][sS][hH][rR][cC](/.*)?$") (regex "^/[uU][sS][eE][rR][sS]/[^/]*/\\.[cC][aA][rR][gG][oO]/[bB][iI][nN](/.*)?$") (regex "^/[uU][sS][eE][rR][sS]/[^/]*/\\.[lL][oO][cC][aA][lL]/[bB][iI][nN](/.*)?$") (regex "^/[uU][sS][eE][rR][sS]/[^/]*/\\.[sS][sS][hH]/[cC][oO][nN][fF][iI][gG](/.*)?$")))
(deny file-write* (require-any (regex "^/[uU][sS][eE][rR][sS]/[^/]*/[lL][iI][bB][rR][aA][rR][yY]/[aA][pP][pP][lL][iI][cC][aA][tT][iI][oO][nN] [sS][uU][pP][pP][oO][rR][tT]/[cC][oO][mM]\\.[aA][pP][pP][lL][eE]\\.[bB][aA][cC][kK][gG][rR][oO][uU][nN][dD][tT][aA][sS][kK][mM][aA][nN][aA][gG][eE][mM][eE][nN][tT][aA][gG][eE][nN][tT](/.*)?$") (regex "^/[uU][sS][eE][rR][sS]/[^/]*/[lL][iI][bB][rR][aA][rR][yY]/[lL][aA][uU][nN][cC][hH][aA][gG][eE][nN][tT][sS](/.*)?$") (regex "^/[uU][sS][eE][rR][sS]/[^/]*/[lL][iI][bB][rR][aA][rR][yY]/[lL][aA][uU][nN][cC][hH][dD][aA][eE][mM][oO][nN][sS](/.*)?$") (regex "^/[lL][iI][bB][rR][aA][rR][yY]/[lL][aA][uU][nN][cC][hH][aA][gG][eE][nN][tT][sS](/.*)?$") (regex "^/[lL][iI][bB][rR][aA][rR][yY]/[lL][aA][uU][nN][cC][hH][dD][aA][eE][mM][oO][nN][sS](/.*)?$")))
(deny file-write-setugid)
(deny file-write-unlink (regex "^/(.*/)?\\.[gG][iI][tT]$"))
(deny lsopen)
(deny mach-lookup (require-any (global-name "com.apple.coreservices.launchservicesd") (global-name-prefix "com.apple.lsd.") (global-name "com.apple.coreservices.appleevents") (global-name "com.apple.pasteboard.1")))
(deny mach-lookup (xpc-service-name-prefix ""))
(deny mach-priv-task-port mach-task-name mach-task-inspect mach-task-read)
(deny process-exec* (file-mode #o2000))
(deny process-exec* (file-mode #o4000))
(deny process-info* (require-not (target same-sandbox)))
(deny signal (target others))
(deny system-fcntl (fcntl-command 80 110))
